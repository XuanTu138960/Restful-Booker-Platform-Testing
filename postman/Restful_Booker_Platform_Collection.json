              "raw": "{\n  \"roomid\": 2,\n  \"firstname\": \"Nguyen\",\n  \"lastname\": \"Xuan Tu\",\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-12-01\",\n    \"checkout\": \"2026-12-05\"\n  },\n  \"email\": \"23010538@st.phenikaa-uni.edu.vn\",\n  \"phone\": \"0987654321\"\n}"
            },
            "url": {
