        {
          "name": "TC_API_09: Create Booking Success (Valid Information)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Booking confirmation contains ID and customer data\", function () {",
